# Base de données PostgreSQL (en local, ou l'adresse Supabase en ligne)
DATABASE_URL="postgresql://diyafa:diyafa@localhost:5432/diyafa"
# Clé secrète pour les sessions (une longue suite de caractères aléatoires)
AUTH_SECRET="change-me-with-a-long-random-string"
# Adresse publique du site
APP_URL="http://localhost:3000"
# Paiement : "test" pour l'instant ; plus tard "moyasar"
PAYMENT_PROVIDER="test"
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
# E-mails : "console" (affichés dans le terminal) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Diyafa <no-reply@diyafa.sa>"
# Fichiers : "local" ou "supabase"
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
