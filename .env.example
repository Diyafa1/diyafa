# Base de données PostgreSQL
# En local : la même adresse deux fois.
# Sur Supabase : DATABASE_URL = "Transaction pooler" (port 6543) + ?pgbouncer=true&connection_limit=1
#                DIRECT_URL   = "Session pooler" (port 5432)
DATABASE_URL="postgresql://diyafa:diyafa@localhost:5432/diyafa"
DIRECT_URL="postgresql://diyafa:diyafa@localhost:5432/diyafa"
# E-mails qui deviennent administrateurs à l'inscription (séparés par des virgules)
ADMIN_EMAILS=""
# Protège la tâche quotidienne (une longue suite de caractères aléatoires)
CRON_SECRET=""
# Clé secrète pour les sessions (une longue suite de caractères aléatoires)
AUTH_SECRET="change-me-with-a-long-random-string"
# Adresse publique du site
APP_URL="http://localhost:3000"
# Connexion avec Google (Gmail) : Google Cloud Console → Identifiants → ID client OAuth
# URI de redirection autorisée : <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Traduction automatique des annonces : Google Cloud → API Cloud Translation → clé API (ou DEEPL_API_KEY)
GOOGLE_TRANSLATE_API_KEY=""
# Alertes Telegram pour le propriétaire : token du bot créé avec @BotFather
TELEGRAM_BOT_TOKEN=""
# Alertes WhatsApp pour le propriétaire (CallMeBot, gratuit) : ton numéro + la clé reçue de CallMeBot
OWNER_WHATSAPP=""
CALLMEBOT_API_KEY=""
# Bouton « Aide sur WhatsApp » visible par les visiteurs (numéro du service client)
SUPPORT_WHATSAPP=""
# Paiement : "test", "stripe" ou "moyasar"
PAYMENT_PROVIDER="test"
# Stripe : Dashboard → Developers → API keys → Secret key (sk_test_… pour essayer, sk_live_… pour de vrai)
STRIPE_SECRET_KEY=""
# Stripe → Développeurs → Webhooks → endpoint <APP_URL>/api/stripe/webhook (checkout.session.completed, checkout.session.expired)
STRIPE_WEBHOOK_SECRET=""
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
# E-mails : "console" (affichés dans le terminal) ou "resend"
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="Diyafa <no-reply@diyafa.sa>"
# Fichiers : "local" ou "supabase"
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
